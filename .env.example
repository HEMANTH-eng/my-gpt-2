# ==============================================================================
# MyGPT Environment Configuration Template
# Copy this file to '.env' and update variables for your target deployment environment.
# ==============================================================================

# --- API Server Settings ---
HOST=0.0.0.0
PORT=8000
DEVICE=cpu # Options: cpu, cuda
MODEL_CONFIG=gpt_micro # Options: gpt_micro, gpt2_small, gpt2_medium
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Training & Checkpoints ---
CHECKPOINT_DIR=checkpoints
LOG_DIR=runs

# --- Next.js Web Interface Settings ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
